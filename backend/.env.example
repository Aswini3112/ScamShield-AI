# ── ScamShield AI — Backend Environment Variables ──────────────────────────
# Copy this file to .env and fill in values. Never commit .env to source control.

# Server
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite for local dev; swap DATABASE_URL for PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./scamshield.db

# ML Model paths (relative to backend/)
MODEL_DIR=../ml/models

# Optional AI provider – leave blank to use deterministic fallback
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# File upload limits
MAX_UPLOAD_MB=10

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30
