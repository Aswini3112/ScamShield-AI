# ── ScamShield AI — Backend Environment Variables ──────────────────────────
# LOCAL DEV : copy this to .env and fill in values
# RENDER    : set these in the Render dashboard under Environment Variables

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development           # production | development
DEBUG=true                    # set false in production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (Render) — replace with your actual Vercel URL:
# ALLOWED_ORIGINS=https://scamshield-ai.vercel.app

# ── Database ──────────────────────────────────────────────────────────────────
# Local:
DATABASE_URL=sqlite+aiosqlite:///./scamshield.db
# Render with persistent disk:
# DATABASE_URL=sqlite+aiosqlite:////opt/render/project/data/scamshield.db
# Production PostgreSQL (optional upgrade):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/scamshield

# ── ML Model ──────────────────────────────────────────────────────────────────
# Local (default: auto-discovered):
# MODEL_DIR=../ml/models
# Render:
# MODEL_DIR=/opt/render/project/src/ml/models

# ── Optional AI providers ─────────────────────────────────────────────────────
# Leave blank to use deterministic ML + rule-based fallback (recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=30
